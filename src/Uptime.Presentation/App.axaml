<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Uptime.Presentation.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#7BC4A8" RegionColor="#0F1114" />
        <ColorPaletteResources x:Key="Light" Accent="#7BC4A8" RegionColor="#0F1114" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Uptime/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
