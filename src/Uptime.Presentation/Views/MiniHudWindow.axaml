<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:Uptime.Presentation.Localization"
        xmlns:v="using:Uptime.Presentation.Views"
        x:Class="Uptime.Presentation.Views.MiniHudWindow"
        Title="Uptime Mini-HUD"
        Width="420" Height="210" MinWidth="380" MinHeight="190"
        CanResize="False" Topmost="True"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        PointerPressed="OnWindowPointerPressed">
  <Window.Styles>
    <Style Selector="Button.hud-btn">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.hud-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#20242B" />
    </Style>
    <Style Selector="Button.hud-btn.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.hud-btn.close:pointerover Path">
      <Setter Property="Stroke" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.hud-btn:pointerover Rectangle">
      <Setter Property="Fill" Value="#FFFFFF" />
    </Style>
  </Window.Styles>
  <Border Background="#111418" BorderBrush="#30363D" BorderThickness="1"
          CornerRadius="14" Padding="20">
    <Grid RowDefinitions="32,*,Auto" RowSpacing="14">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
        <Image Width="22" Height="22" Source="/Assets/uptime.png" Stretch="Uniform"
               VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="Uptime" FontSize="14" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Border Grid.Column="2" Background="#20242A" CornerRadius="12" Padding="10,5"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#DCE8E2"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center" Margin="4,0,0,0">
          <Button Classes="hud-btn"
                  i18n:Localize.TipKey="ToolMinimize" i18n:Localize.AutomationNameKey="ToolMinimize" Click="OnMinimizeClick">
            <Rectangle Width="9" Height="1.5" Fill="#9AA0A9" RadiusX="0.75" RadiusY="0.75" />
          </Button>
          <Button Classes="hud-btn close"
                  i18n:Localize.TipKey="HudClose" i18n:Localize.AutomationNameKey="HudClose" Click="OnCloseClick">
            <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="#9AA0A9" StrokeThickness="1.5" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
        <StackPanel Spacing="-2" VerticalAlignment="Center">
          <TextBlock Text="{Binding PrimaryText}" FontSize="46" FontWeight="Light"
                     LetterSpacing="-1.2" />
          <TextBlock Text="{Binding SecondaryText}" FontSize="13" Foreground="#AEB5BD" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Classes="lbl" i18n:Localize.TextKey="HudTarget" Margin="0" FontSize="10"
                     HorizontalAlignment="Right" />
          <TextBlock Text="{Binding HudThresholdText}" FontSize="20" FontWeight="Medium"
                     HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="2" Spacing="7">
        <ProgressBar Minimum="0" Maximum="168" Value="{Binding FilledTicks}"
                     Height="6" Background="#292F35" Foreground="#7BC4A8" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="muted" FontSize="10" i18n:Localize.TextKey="RulerStart" />
          <TextBlock Grid.Column="1" Classes="muted" FontSize="10"
                     Text="{Binding HudThresholdText}" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
