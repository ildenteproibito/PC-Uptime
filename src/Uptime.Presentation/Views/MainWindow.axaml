<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="using:Uptime.Presentation.Localization"
        xmlns:v="using:Uptime.Presentation.Views"
        xmlns:vm="using:Uptime.Presentation.ViewModels"
        x:Class="Uptime.Presentation.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Uptime"
        Icon="avares://Uptime/Assets/uptime.ico"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Width="1340" Height="720" MinWidth="1290" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">
  <Grid>
    <!-- Custom User Wallpaper (if selected) -->
    <Image Source="{Binding Settings.CustomBackgroundImage}" Stretch="UniformToFill"
           RenderOptions.BitmapInterpolationMode="LowQuality"
           IsVisible="{Binding Settings.ShowMainBackground}">
      <Image.Effect>
        <BlurEffect Radius="{Binding Settings.BackgroundBlur}" />
      </Image.Effect>
    </Image>
    <Border Background="{DynamicResource BgBrush}" Opacity="{Binding Settings.BackgroundDim}"
            IsVisible="{Binding Settings.HasCustomBackgroundImage}" IsHitTestVisible="False" />
    <Border Opacity="{Binding Settings.BackgroundVignette}"
            IsVisible="{Binding Settings.HasCustomBackgroundImage}" IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="75%" RadiusY="75%">
          <GradientStop Offset="0.0" Color="#00000000" />
          <GradientStop Offset="0.65" Color="#44000000" />
          <GradientStop Offset="1.0" Color="#E6000000" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <!-- Main Window Structure -->
    <Grid RowDefinitions="56,*" PointerPressed="OnWindowDragPointerPressed">
    <Border Grid.Row="0" Padding="18,0">
      <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
        <!-- Left: Logo & App Title -->
        <StackPanel x:Name="HeaderLeftPanel" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Image Width="32" Height="32" Source="/Assets/uptime.png" Stretch="Uniform" />
          <TextBlock Text="Uptime" FontWeight="SemiBold" FontSize="19" />
        </StackPanel>

        <!-- Center: Navigation Tabs (mathematically centered) -->
        <StackPanel x:Name="NavTabsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" HorizontalAlignment="Center">
          <Button Classes="nav top-tab" Classes.on="{Binding IsMonitor}"
                  Command="{Binding NavigateCommand}" CommandParameter="Monitor"
                  i18n:Localize.ContentKey="NavMonitor" />
          <Button Classes="nav top-tab" Classes.on="{Binding IsStability}"
                  Command="{Binding NavigateCommand}" CommandParameter="Stability"
                  i18n:Localize.ContentKey="NavStability" />
          <Button Classes="nav top-tab" Classes.on="{Binding IsOperations}"
                  Command="{Binding NavigateCommand}" CommandParameter="Operations"
                  i18n:Localize.ContentKey="NavOperations" />
          <Button Classes="nav top-tab" Classes.on="{Binding IsWallpapers}"
                  Command="{Binding NavigateCommand}" CommandParameter="Wallpapers"
                  i18n:Localize.ContentKey="NavWallpapers" />
        </StackPanel>

        <!-- Right: Language Switch, Settings and Window Controls -->
        <StackPanel x:Name="HeaderRightPanel" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Stretch" HorizontalAlignment="Right">
          <Border Classes="language-switch" VerticalAlignment="Center">
            <Grid ColumnDefinitions="28,28,28" ColumnSpacing="2">
              <Border Width="28" Height="30" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                      CornerRadius="6" RenderTransformOrigin="0%,50%">
                <Border.RenderTransform>
                  <TranslateTransform X="{Binding LanguageIndicatorOffset}" />
                </Border.RenderTransform>
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="TranslateTransform.X" Duration="0:0:0.18" />
                  </Transitions>
                </Border.Transitions>
              </Border>
              <Button Grid.Column="0" Classes="language-option" Classes.on="{Binding IsItalian}"
                      Command="{Binding SetLanguageCommand}" CommandParameter="it"
                      i18n:Localize.TipKey="PrefLanguage">IT</Button>
              <Button Grid.Column="1" Classes="language-option" Classes.on="{Binding IsEnglish}"
                      Command="{Binding SetLanguageCommand}" CommandParameter="en"
                      i18n:Localize.TipKey="PrefLanguage">EN</Button>
              <Button Grid.Column="2" Classes="language-option" Classes.on="{Binding IsRussian}"
                      Command="{Binding SetLanguageCommand}" CommandParameter="ru"
                      i18n:Localize.TipKey="PrefLanguage">RU</Button>
            </Grid>
          </Border>
          <Border Width="1" Height="20" Margin="2,0" Background="{DynamicResource LineBrush}" VerticalAlignment="Center" />
          <Button Classes="nav top-tab" Padding="8,8,8,10" Classes.on="{Binding IsSettings}" Command="{Binding OpenSettingsCommand}"
                  i18n:Localize.ContentKey="NavSettings" />
          <Button Classes="nav top-tab" Padding="8,8,8,10" Classes.on="{Binding IsAssistant}" Command="{Binding OpenAssistantCommand}"
                  i18n:Localize.ContentKey="NavAssistant" />
          <Button Classes="nav top-tab" Padding="8,8,8,10" Classes.on="{Binding IsAbout}" Command="{Binding OpenAboutCommand}"
                  i18n:Localize.ContentKey="NavAbout" />
          <Border Width="1" Height="20" Margin="2,0" Background="{DynamicResource LineBrush}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="0">
            <Button Classes="window-control" i18n:Localize.TipKey="ToolMinimize" Click="OnMinimizeClick" i18n:Localize.AutomationNameKey="ToolMinimize">
              <Path Data="M3,8 L13,8" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" />
            </Button>
            <Button Classes="window-control" i18n:Localize.TipKey="ToolMaximize" Click="OnToggleMaximizeClick" i18n:Localize.AutomationNameKey="ToolMaximize">
              <Grid Width="16" Height="16">
                <Path x:Name="MaximizeIcon" Data="M3,3 L13,3 13,13 3,13 Z" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" />
                <Path x:Name="RestoreIcon" IsVisible="False" Data="M5,3 L13,3 13,11 M3,5 L11,5 11,13 3,13 Z" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" />
              </Grid>
            </Button>
            <Button Classes="window-control close" i18n:Localize.TipKey="ToolClose" Click="OnCloseClick" i18n:Localize.AutomationNameKey="ToolClose">
              <Grid Width="16" Height="16">
                <Path Data="M3,3 L13,13 M13,3 L3,13" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" />
              </Grid>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid IsVisible="{Binding IsMonitor}">
        <v:MonitorView DataContext="{Binding Monitor}" />
      </Grid>
      <Grid IsVisible="{Binding IsStability}">
        <v:StabilityView DataContext="{Binding Stability}" />
      </Grid>
      <Grid IsVisible="{Binding IsOperations}">
        <v:OperationsView DataContext="{Binding Operations}" />
      </Grid>
      <Grid IsVisible="{Binding IsWallpapers}">
        <v:WallpapersView DataContext="{Binding Settings}" />
      </Grid>
      <Grid IsVisible="{Binding IsSettings}">
        <v:SettingsView DataContext="{Binding Settings}" />
      </Grid>
      <Grid IsVisible="{Binding IsAbout}">
        <v:AboutView />
      </Grid>
      <Grid IsVisible="{Binding IsAssistant}">
        <v:AssistantView DataContext="{Binding Assistant}" />
      </Grid>

      <!-- Global Draggable OLED Mascot Overlay across all tabs -->
      <Canvas x:Name="MascotLayer" ClipToBounds="False"
              IsVisible="{Binding Monitor.ShowMascot}">
        <Grid x:Name="MascotOverlay" Background="Transparent" Cursor="Hand"
              ClipToBounds="False"
              PointerPressed="OnMascotPointerPressed"
              PointerMoved="OnMascotPointerMoved"
              PointerReleased="OnMascotPointerReleased"
              PointerCaptureLost="OnMascotPointerCaptureLost">
          <Canvas Height="0" Width="0" HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="False" ZIndex="10" IsHitTestVisible="False">
            <Border x:Name="MascotBubbleBorder"
                    Background="#EB121822" BorderBrush="{Binding Monitor.MascotStatusBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="11,7"
                    Canvas.Left="-95" Canvas.Top="-44"
                    IsVisible="{Binding Monitor.IsMascotBubbleVisible}">
              <TextBlock Text="{Binding Monitor.MascotBubbleText}" Foreground="{DynamicResource TextBrush}"
                         FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="190" />
            </Border>
          </Canvas>
          <StackPanel Spacing="6" IsHitTestVisible="False">
            <Grid Width="124" Height="124" HorizontalAlignment="Center">
              <Image x:Name="MascotImageControl" Source="{Binding Monitor.MascotImage}" Width="124" Height="124" Stretch="Uniform"
                     HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
              <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                      Background="#DC101722" BorderBrush="{Binding Monitor.MascotStatusBrush}" BorderThickness="1"
                      CornerRadius="12" Padding="6,2"
                      IsVisible="{Binding Monitor.HasMascotAccessory}">
                <TextBlock Text="{Binding Monitor.MascotAccessoryBadge}" FontSize="14" />
              </Border>
            </Grid>
            <Border Background="#CC0F151D" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="10,4" HorizontalAlignment="Center">
              <TextBlock Text="{Binding Monitor.MascotStatusText}" Foreground="{Binding Monitor.MascotStatusBrush}"
                         FontSize="11.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="160" />
            </Border>
          </StackPanel>
        </Grid>
      </Canvas>

      <!-- Uppy Guided Tour Overlay -->
      <Border ZIndex="20"
              IsVisible="{Binding IsTutorialActive}"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="24,0,24,28"
              MaxWidth="560"
              MinWidth="420"
              Background="#EE101722"
              BorderBrush="{DynamicResource AccentBrush}"
              BorderThickness="1.5"
              CornerRadius="20"
              Padding="20,18"
              BoxShadow="0 16 40 0 #B0000000">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
            <Border Width="44" Height="44" CornerRadius="12"
                    Background="#2238BDF8" BorderBrush="#4438BDF8" BorderThickness="1">
              <Image Source="{Binding Monitor.MascotImage}" Width="36" Height="36" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <Border HorizontalAlignment="Left" Padding="8,2" CornerRadius="8" Background="#2638BDF8">
                <TextBlock i18n:Localize.TextKey="TutBadge" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
              </Border>
              <TextBlock Text="{Binding TutorialTitle}" FontSize="16" FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="2" VerticalAlignment="Top" Padding="9,4" CornerRadius="10"
                    Background="#1FFFFFFF" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
              <TextBlock Text="{Binding TutorialStepCounter}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
          </Grid>

          <TextBlock Text="{Binding TutorialBody}" FontSize="13.5" LineHeight="20"
                     Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <Button Classes="ghost" i18n:Localize.ContentKey="TutSkip"
                    Command="{Binding SkipTutorialCommand}" />
            <Button Grid.Column="2" Classes="ghost" i18n:Localize.ContentKey="TutBack"
                    IsVisible="{Binding CanTutorialGoBack}"
                    Command="{Binding PreviousTutorialStepCommand}" />
            <Button Grid.Column="3" Classes="accent"
                    Content="{Binding TutorialPrimaryButtonText}"
                    Command="{Binding NextTutorialStepCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <v:WallpaperStudioView DataContext="{Binding Settings}"
                             IsVisible="{Binding IsStudioOpen}" />
    </Grid>
  </Grid>
  </Grid>
</Window>
