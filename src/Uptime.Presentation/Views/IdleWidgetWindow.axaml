<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="using:Uptime.Presentation.Localization"
        xmlns:v="using:Uptime.Presentation.Views"
        xmlns:vm="using:Uptime.Presentation.ViewModels"
        x:Class="Uptime.Presentation.Views.IdleWidgetWindow"
        x:DataType="vm:MonitorViewModel"
        Title="Uptime Idle"
        Width="520" Height="360" MinWidth="480" MinHeight="320"
        CanResize="False" Topmost="True"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        PointerMoved="OnActivityPointerMoved"
        KeyDown="OnActivityKeyDown"
        PointerPressed="OnWindowPointerPressed">
  <Border x:Name="RootBorder" Background="#000000" BorderBrush="#1C2028" BorderThickness="0"
          CornerRadius="0" Padding="28" BoxShadow="0 16 32 0 #70000000">
    <Grid x:Name="ContentRoot" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16" HorizontalAlignment="Stretch">
      <!-- Header -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Width="20" Height="20" Source="/Assets/uptime.png" Stretch="Uniform" />
          <TextBlock Text="Uptime" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DimBrush}" />
          <TextBlock Text="·" FontSize="13" Foreground="{DynamicResource LineBrush}" />
          <TextBlock i18n:Localize.TextKey="IdleWidgetTitle" FontSize="13" Foreground="{DynamicResource AccentBrush}" FontWeight="Medium" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="FullscreenToggleBtn" Classes="ghost" MinHeight="26" Height="26" Padding="10,0" FontSize="11"
                  i18n:Localize.ContentKey="StandByWindowed" Click="OnToggleFullscreenClick" />
          <Button Width="28" Height="28" Padding="0"
                  Background="Transparent" BorderThickness="0" CornerRadius="6"
                  Click="OnCloseClick" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <Path Data="M5,5 L13,13 M13,5 L5,13" Stroke="#8A909A" StrokeThickness="1.4" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Center: Bouncing clock and idle status (OLED burn-in protection) -->
      <Canvas x:Name="BounceArea" Grid.Row="1" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel x:Name="BounceBlock" Spacing="8">
          <TextBlock x:Name="ClockText" Text="12:00" FontSize="72" FontWeight="Light"
                     LetterSpacing="-2" HorizontalAlignment="Center" Foreground="#F0F3F6" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Border Background="#12151B" BorderBrush="#222732" BorderThickness="1" CornerRadius="10" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="UptimeSummaryText" Text="—" FontSize="12" Foreground="#D0D6DE" />
              </StackPanel>
            </Border>
            <Border x:Name="BatteryBadge" IsVisible="False" Background="#12151B" BorderBrush="#222732" BorderThickness="1" CornerRadius="10" Padding="10,4">
              <TextBlock x:Name="BatteryBadgeText" Text="—" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <Border Background="#1B1610" BorderBrush="#34281B" BorderThickness="1" CornerRadius="10" Padding="10,4">
              <TextBlock i18n:Localize.TextKey="IdleSubtitle" FontSize="12" Foreground="{DynamicResource AmberBrush}" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Canvas>

      <!-- Spotify Widget if active -->
      <v:SpotifyWidgetView Grid.Row="2" MaxWidth="640" HorizontalAlignment="Center" DataContext="{Binding Spotify}" Margin="0,4,0,0"
                           IsVisible="{Binding HasTrack, FallbackValue=False}" />

      <!-- Footer: Resume activity hint -->
      <StackPanel Grid.Row="3" HorizontalAlignment="Center" Spacing="4" Margin="0,4,0,0">
        <TextBlock Classes="muted" FontSize="12" HorizontalAlignment="Center"
                   i18n:Localize.TextKey="IdleResumeHint" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
