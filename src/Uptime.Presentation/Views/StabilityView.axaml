<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="using:Uptime.Presentation.Localization"
             xmlns:c="using:Uptime.Presentation.Controls"
             xmlns:vm="using:Uptime.Presentation.ViewModels"
             x:Class="Uptime.Presentation.Views.StabilityView">
  <Grid RowDefinitions="*,62">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
      <Grid ColumnDefinitions="300,*" ColumnSpacing="72" Margin="56,40,56,24">

        <StackPanel Grid.Column="0">
          <TextBlock Classes="lbl" i18n:Localize.TextKey="LblStability30" />
          <TextBlock Text="{Binding ScoreText}" FontSize="88" FontWeight="Light" LetterSpacing="-2" />
          <TextBlock Text="{Binding ConfidenceText}" Foreground="{Binding ConfidenceBrush}" FontSize="14" Margin="0,14,0,0" />
          <TextBlock Classes="muted" FontSize="14" LineHeight="22" TextWrapping="Wrap" Margin="0,10,0,0"
                     Text="{Binding SummaryText}" />
          <TextBlock Classes="lbl" Margin="0,36,0,10" i18n:Localize.TextKey="LblLongest" />
          <TextBlock FontSize="26" FontWeight="Light" Text="{Binding LongestText}" />
        </StackPanel>

        <StackPanel Grid.Column="1">
          <TextBlock Classes="muted" FontSize="14" i18n:Localize.TextKey="StabLoading" IsVisible="{Binding IsLoading}" />
          <TextBlock Foreground="{DynamicResource AmberBrush}" FontSize="14" TextWrapping="Wrap"
                     i18n:Localize.TextKey="StabError" IsVisible="{Binding HasError}" />

          <TextBlock Classes="lbl" i18n:Localize.TextKey="LblTimeline" />
          <c:SessionTimeline Height="64" Margin="0,0,0,12" Segments="{Binding Segments}"
                             LeftLabel="{Binding LeftLabelText}" RightLabel="{Binding RightLabelText}" />

          <TextBlock Classes="lbl" i18n:Localize.TextKey="LblHistory" />
          <ItemsControl ItemsSource="{Binding Sessions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionRow">
                <Border Classes="row">
                  <Grid ColumnDefinitions="150,*,90">
                    <TextBlock Classes="muted" FontSize="14" Text="{Binding DateText}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <Ellipse Width="8" Height="8" Fill="{Binding OutcomeBrush}" VerticalAlignment="Center" />
                      <TextBlock FontSize="14" Text="{Binding OutcomeText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="muted" FontSize="14" HorizontalAlignment="Right"
                               Text="{Binding DurationText}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="lbl" Margin="0,28,0,10" i18n:Localize.TextKey="LblIncidents" />
          <TextBlock Classes="muted" FontSize="14" i18n:Localize.TextKey="NoIncidents" IsVisible="{Binding HasNoIncidents}" />
          <ItemsControl ItemsSource="{Binding Incidents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="#C4C8CF"
                           Margin="0,0,0,6" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}" Padding="28,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Left">
        <Button Classes="ghost" i18n:Localize.ContentKey="ActionReload" Command="{Binding ReloadCommand}"
                IsEnabled="{Binding !IsLoading}" />
        <Button Classes="ghost" i18n:Localize.ContentKey="ExportJson" Click="OnExportJsonClick" />
        <Button Classes="ghost" i18n:Localize.ContentKey="ExportCsv" Click="OnExportCsvClick" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
