<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="using:Uptime.Presentation.Localization"
             xmlns:c="using:Uptime.Presentation.Controls"
             xmlns:v="using:Uptime.Presentation.Views"
             xmlns:vm="using:Uptime.Presentation.ViewModels"
             x:Class="Uptime.Presentation.Views.StabilityView"
             x:DataType="vm:StabilityViewModel">
  <Grid RowDefinitions="*,62">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
      <Grid ColumnDefinitions="320,*" ColumnSpacing="28" Margin="56,36,56,24">

        <Border Grid.Column="0" Classes="glass-card" Padding="24,20" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Classes="lbl" i18n:Localize.TextKey="LblStability30" />
            <TextBlock Text="{Binding ScoreText}" FontSize="88" FontWeight="Light" LetterSpacing="-2" />
            <TextBlock Text="{Binding ConfidenceText}" Foreground="{Binding ConfidenceBrush}" FontSize="14" Margin="0,14,0,0" />
            <TextBlock Classes="muted" FontSize="14" LineHeight="22" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="{Binding SummaryText}" />
            <TextBlock Classes="lbl" Margin="0,36,0,10" i18n:Localize.TextKey="LblLongest" />
            <TextBlock FontSize="26" FontWeight="Light" Text="{Binding LongestText}" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Spacing="20">
          <TextBlock Classes="muted" FontSize="14" i18n:Localize.TextKey="StabLoading" IsVisible="{Binding IsLoading}" />
          <TextBlock Foreground="{DynamicResource AmberBrush}" FontSize="14" TextWrapping="Wrap"
                     i18n:Localize.TextKey="StabError" IsVisible="{Binding HasError}" />

          <Border Classes="glass-card" Padding="20,16">
            <StackPanel>
              <TextBlock Classes="lbl" i18n:Localize.TextKey="LblTimeline" />
              <c:SessionTimeline Height="64" Segments="{Binding Segments}"
                                 LeftLabel="{Binding LeftLabelText}" RightLabel="{Binding RightLabelText}" />
            </StackPanel>
          </Border>

          <Border Classes="glass-card" Padding="20,16">
            <StackPanel>
              <TextBlock Classes="lbl" i18n:Localize.TextKey="LblHistory" />
              <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SessionRow">
                    <Border Classes="row">
                      <Grid ColumnDefinitions="150,*,90">
                        <TextBlock Classes="muted" FontSize="14" Text="{Binding DateText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                          <Ellipse Width="8" Height="8" Fill="{Binding OutcomeBrush}" VerticalAlignment="Center" />
                          <TextBlock FontSize="14" Text="{Binding OutcomeText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="muted" FontSize="14" HorizontalAlignment="Right"
                                   Text="{Binding DurationText}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="glass-card" Padding="20,16">
            <StackPanel>
              <TextBlock Classes="lbl" i18n:Localize.TextKey="LblIncidents" />
              <TextBlock Classes="muted" FontSize="14" i18n:Localize.TextKey="NoIncidents" IsVisible="{Binding HasNoIncidents}" />
              <ItemsControl ItemsSource="{Binding SystemEventLogs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SystemEventLogRow">
                    <Border Background="#52000000" BorderBrush="#1FFFFFFF" BorderThickness="1"
                            CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <Border Background="#28000000" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding LevelBrush}" />
                          </Border>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Provider}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="·" FontSize="13" Foreground="{DynamicResource DimBrush}" />
                            <TextBlock Text="{Binding DateText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#28000000" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                              <TextBlock Text="{Binding EventIdText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas, monospace" />
                            </Border>
                            <Button Classes="ghost" MinHeight="24" Height="24" Padding="8,0" FontSize="11"
                                    i18n:Localize.ContentKey="BtnCommunityFix"
                                    Command="{Binding $parent[v:StabilityView].((vm:StabilityViewModel)DataContext).OpenFixForIncidentCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="17" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="glass-card" Padding="20,16">
            <StackPanel>
              <TextBlock Classes="lbl" i18n:Localize.TextKey="LblAppCrashes" />
              <TextBlock Classes="muted" FontSize="14" i18n:Localize.TextKey="NoAppCrashes" IsVisible="{Binding HasNoAppCrashes}" />
              <ItemsControl ItemsSource="{Binding AppCrashes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AppCrashRow">
                    <Border Background="#52000000" BorderBrush="#1FFFFFFF" BorderThickness="1"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Background="#28000000" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding KindText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding KindBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                          <TextBlock Text="{Binding AppName}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding ModuleText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding ModuleText.Length}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DateText}" FontSize="12" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" />
                          <Button Classes="ghost" MinHeight="24" Height="24" Padding="8,0" FontSize="11"
                                  i18n:Localize.ContentKey="BtnCommunityFix"
                                  Command="{Binding $parent[v:StabilityView].((vm:StabilityViewModel)DataContext).OpenFixForCrashCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="glass-card" Padding="20,16">
            <StackPanel Spacing="8">
              <TextBlock Classes="lbl" i18n:Localize.TextKey="LblNetworkWatchdog" />
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Background="#28000000" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding NetworkStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding NetworkStatusBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding NetworkGatewayText}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Text="{Binding NetworkDropsCountText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Classes="ghost" MinHeight="28" Height="28" Padding="10,0" FontSize="12"
                        i18n:Localize.ContentKey="BtnNetProbe" Command="{Binding ProbeNetworkNowCommand}" />
              </Grid>
              <TextBlock Classes="muted" FontSize="12" i18n:Localize.TextKey="NetNoDrops" IsVisible="{Binding HasNoNetworkDrops}" />
              <ItemsControl ItemsSource="{Binding NetworkDrops}" IsVisible="{Binding NetworkDrops.Count}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NetworkDropRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0" ColumnSpacing="8">
                      <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource DimBrush}" FontFamily="Consolas, monospace" />
                      <TextBlock Grid.Column="1" Text="{Binding Target}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock Grid.Column="2" Text="{Binding Reason}" FontSize="11" Foreground="{DynamicResource OrangeBrush}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Community Fixes & Event ID Wiki -->
          <Border x:Name="CommunityFixesCard" Classes="glass-card" Padding="20,16">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Classes="lbl" Margin="0" i18n:Localize.TextKey="LblCommunityFixes" />
                  <TextBlock Classes="hint" FontSize="12" i18n:Localize.TextKey="CommunityFixesDesc" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" MinHeight="32" Height="32" Padding="12,0" FontSize="12"
                        VerticalAlignment="Center"
                        i18n:Localize.ContentKey="BtnShareFix"
                        Command="{Binding ToggleFixSubmitCommand}" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding FixesSearchQuery, Mode=TwoWay}"
                         i18n:Localize.WatermarkKey="FixSearchWatermark"
                         KeyDown="OnFixSearchKeyDown"
                         Background="#40000000" BorderBrush="{DynamicResource LineBrush}" CornerRadius="8" />
                <Button Grid.Column="1" Classes="ghost" MinHeight="34" Height="34" Padding="14,0" FontSize="12"
                        i18n:Localize.ContentKey="BtnSearchFixes"
                        Command="{Binding SearchFixesCommand}" IsEnabled="{Binding !IsFixesLoading}" />
              </Grid>

              <!-- Expandable Submit Fix Form -->
              <Border Background="#52000000" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14"
                      IsVisible="{Binding IsFixSubmitOpen}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="8">
                    <TextBox Text="{Binding NewFixEventId}" i18n:Localize.WatermarkKey="FixEventIdWatermark" MaxLength="12" />
                    <TextBox Grid.Column="1" Text="{Binding NewFixProvider}" i18n:Localize.WatermarkKey="FixProviderWatermark" MaxLength="80" />
                  </Grid>
                  <TextBox Text="{Binding NewFixTitle}" i18n:Localize.WatermarkKey="FixTitleWatermark" MaxLength="120" />
                  <TextBox Text="{Binding NewFixSteps}" i18n:Localize.WatermarkKey="FixStepsWatermark"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxLength="1600" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding NewFixAuthor}" i18n:Localize.WatermarkKey="FixAuthorWatermark" MaxLength="40" />
                    <Button Grid.Column="1" Classes="ghost" MinHeight="34" Height="34" Padding="16,0" FontSize="12"
                            i18n:Localize.ContentKey="BtnSubmitFix"
                            Command="{Binding SubmitFixCommand}" IsEnabled="{Binding !IsFixSubmitting}" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding FixesStatusText}" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                         IsVisible="{Binding FixesStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         TextWrapping="Wrap" />
              <TextBlock Classes="muted" FontSize="12.5" i18n:Localize.TextKey="FixesLoading" IsVisible="{Binding IsFixesLoading}" />
              <TextBlock Classes="muted" FontSize="12.5" i18n:Localize.TextKey="FixesEmpty" IsVisible="{Binding HasNoFixes}" TextWrapping="Wrap" />

              <ItemsControl ItemsSource="{Binding CommunityFixes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CommunityFixCard">
                    <Border Background="#52000000" BorderBrush="#1FFFFFFF" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                          <Border Background="#28000000" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EventIdBadge}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas, monospace" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Provider}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="ghost" MinHeight="26" Height="26" Padding="10,0" FontSize="11.5"
                                    Command="{Binding $parent[v:StabilityView].((vm:StabilityViewModel)DataContext).UpvoteFixCommand}"
                                    CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="▲" FontSize="10" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Upvotes}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                            <Button Classes="ghost" MinHeight="26" Height="26" Padding="8,0" FontSize="11"
                                    i18n:Localize.ContentKey="BtnReportFix"
                                    Command="{Binding $parent[v:StabilityView].((vm:StabilityViewModel)DataContext).ReportFixCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Steps}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" />
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Author}" FontSize="11.5" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" />
                          <Image Source="{Binding RoleIcon}" IsVisible="{Binding HasRoleIcon}" Width="13" Height="13" VerticalAlignment="Center"
                                 RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="1" Padding="28,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Left">
        <Button Classes="ghost" i18n:Localize.ContentKey="ActionReload" Command="{Binding ReloadCommand}"
                IsEnabled="{Binding !IsLoading}" />
        <Button Classes="ghost" i18n:Localize.ContentKey="ExportJson" Click="OnExportJsonClick" />
        <Button Classes="ghost" i18n:Localize.ContentKey="ExportCsv" Click="OnExportCsvClick" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
