<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="using:Uptime.Presentation.Localization"
             xmlns:c="using:Uptime.Presentation.Controls"
             x:Class="Uptime.Presentation.Views.OperationsView">
  <Grid RowDefinitions="*,76">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="72" Margin="56,32,56,24">

        <StackPanel Grid.Column="0">
          <TextBlock Classes="lbl" i18n:Localize.TextKey="LblPower" />

          <Border Classes="row"><Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" i18n:Localize.TextKey="OpRestart" />
              <TextBlock Classes="hint" i18n:Localize.TextKey="OpRestartDesc" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" i18n:Localize.ContentKey="BtnRestart" Command="{Binding RequestRestartCommand}" />
          </Grid></Border>

          <Border Classes="row"><Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" i18n:Localize.TextKey="OpShutdown" />
              <TextBlock Classes="hint" i18n:Localize.TextKey="OpShutdownDesc" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" i18n:Localize.ContentKey="BtnShutdown" Command="{Binding RequestShutdownCommand}" />
          </Grid></Border>

          <Border Classes="row"><Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" i18n:Localize.TextKey="OpUefi" />
              <TextBlock Classes="hint" i18n:Localize.TextKey="OpUefiDesc" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" i18n:Localize.ContentKey="BtnUefi" Command="{Binding RequestUefiCommand}" />
          </Grid></Border>

          <Border Classes="row"><Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" i18n:Localize.TextKey="OpTimer" />
              <TextBlock Classes="hint" i18n:Localize.TextKey="OpTimerDesc" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost" Content="30 m" Command="{Binding StartTimerCommand}" CommandParameter="30" />
              <Button Classes="ghost" Content="60 m" Command="{Binding StartTimerCommand}" CommandParameter="60" />
              <Button Classes="ghost" Content="120 m" Command="{Binding StartTimerCommand}" CommandParameter="120" />
            </StackPanel>
          </Grid></Border>

          <c:TimeRuler Height="64" Margin="0,16,0,0" TotalTicks="60" MajorEvery="15" GoodTicks="60"
                       FilledTicks="{Binding TimerFilledTicks}" Labels="{Binding TimerLabels}" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center" Text="{Binding TimerText}" />
            <Button Grid.Column="1" Classes="ghost" i18n:Localize.ContentKey="BtnCancel"
                    Command="{Binding CancelTimerCommand}" IsVisible="{Binding TimerActive}" />
          </Grid>

          <!-- Power and battery status -->
          <TextBlock Classes="lbl" Margin="0,28,0,10" i18n:Localize.TextKey="LblBattery" />
          <Border Background="#16191F" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="14,12">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding BatteryStatusText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Text="{Binding BatteryDetailsText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="#1D222A" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" IsVisible="{Binding HasBattery}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding BatteryHealthText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Classes="muted" FontSize="11" i18n:Localize.TextKey="BatteryHealthShort" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid ColumnDefinitions="*,*" Margin="0,4,0,0" IsVisible="{Binding HasBattery}">
                <StackPanel Spacing="2">
                  <TextBlock Classes="muted" FontSize="11" i18n:Localize.TextKey="BatteryCycles" />
                  <TextBlock Text="{Binding BatteryCyclesText}" FontSize="14" FontWeight="Medium" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Classes="muted" FontSize="11" i18n:Localize.TextKey="BatteryHealth" />
                  <TextBlock Text="{Binding BatteryHealthText}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1">
          <TextBlock Classes="lbl" i18n:Localize.TextKey="LblPrefs" />

          <Border Classes="row"><Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" i18n:Localize.TextKey="PrefFast" />
              <TextBlock Classes="hint" i18n:Localize.TextKey="PrefFastDesc" IsVisible="{Binding FastStartupAvailable}" />
              <TextBlock Classes="hint" i18n:Localize.TextKey="FastUnknown" IsVisible="{Binding !FastStartupAvailable}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" i18n:Localize.OnKey="StateOn" i18n:Localize.OffKey="StateOff" Click="OnFastStartupClick"
                          IsChecked="{Binding FastStartupEnabled, Mode=OneWay}">
              <ToggleSwitch.IsEnabled>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="FastStartupAvailable" />
                  <Binding Path="!IsBusy" />
                </MultiBinding>
              </ToggleSwitch.IsEnabled>
            </ToggleSwitch>
          </Grid></Border>

          <Border Classes="row"><Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" i18n:Localize.TextKey="PrefStartup" />
              <TextBlock Classes="hint" i18n:Localize.TextKey="PrefStartupDesc" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" i18n:Localize.OnKey="StateOn" i18n:Localize.OffKey="StateOff" Click="OnRunAtStartupClick"
                          IsChecked="{Binding RunAtStartup, Mode=OneWay}" />
          </Grid></Border>

          <!-- Sleep Inspector -->
          <TextBlock Classes="lbl" Margin="0,28,0,10" i18n:Localize.TextKey="LblSleepInspector" />
          <Border Background="#16191F" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="14,10">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding SleepStatusText}" FontSize="13" Foreground="{DynamicResource TextBrush}"
                             IsVisible="{Binding SleepStatusText.Length}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding FormattedLastWake}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                             IsVisible="{Binding FormattedLastWake.Length}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" MinHeight="32" Height="32" Padding="14,0" FontSize="12"
                        VerticalAlignment="Center"
                        i18n:Localize.ContentKey="BtnCheckSleep"
                        Command="{Binding CheckSleepBlockersCommand}" IsEnabled="{Binding !IsSleepLoading}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding SleepBlockers}" IsVisible="{Binding SleepBlockers.Count}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#1C2027" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Background="#252B35" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                          <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OrangeBrush}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="#D0D5DD" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding L[SleepRequiresAdmin]}" FontSize="11" Foreground="{DynamicResource DimBrush}"
                         IsVisible="{Binding ShowAdminNotice}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Startup Applications -->
          <TextBlock Classes="lbl" Margin="0,28,0,10" i18n:Localize.TextKey="LblStartupApps" />
          <Border Background="#16191F" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="14,12">
            <StackPanel Spacing="6">
              <TextBlock Classes="muted" FontSize="13" i18n:Localize.TextKey="StartupNoApps" IsVisible="{Binding !StartupApps.Count}" />
              <ItemsControl ItemsSource="{Binding StartupApps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Padding="0,6">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" />
                          <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource DimBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1D222A" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding ImpactText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ImpactBrush}" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}" Padding="28,0">
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" IsVisible="{Binding IsConfirming}">
          <TextBlock Text="{Binding ConfirmText}" FontSize="14" VerticalAlignment="Center" />
          <Button Classes="ghost" i18n:Localize.ContentKey="BtnConfirm" Command="{Binding ConfirmPendingCommand}" />
          <Button Classes="ghost" i18n:Localize.ContentKey="BtnCancel" Command="{Binding CancelPendingCommand}" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding ShowFooterInfo}">
          <TextBlock FontSize="13" Foreground="{DynamicResource AmberBrush}" Text="{Binding StatusMessage}" />
          <TextBlock FontSize="13" Foreground="{DynamicResource DimBrush}" i18n:Localize.TextKey="FooterNoTelemetry" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
