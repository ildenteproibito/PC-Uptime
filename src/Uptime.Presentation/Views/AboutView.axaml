<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="using:Uptime.Presentation.Localization"
             xmlns:vm="using:Uptime.Presentation.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="Uptime.Presentation.Views.AboutView">
  <UserControl.Resources>
    <DataTemplate x:Key="AboutConnectionChipTemplate" x:DataType="vm:ConnectedAccountCard">
      <Button Margin="0,2,8,2" Padding="10,5" CornerRadius="10" Cursor="Hand"
              Background="{Binding BrandBgBrush}" BorderBrush="{Binding BrandBorderBrush}" BorderThickness="1"
              IsEnabled="{Binding HasUrl}"
              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Settings.OpenConnectionUrlCommand}"
              CommandParameter="{Binding}">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Viewbox Width="13" Height="13">
            <Path Width="24" Height="24" Fill="{Binding BrandBrush}" Data="{Binding IconPath}" />
          </Viewbox>
          <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F1F5F9" />
          <TextBlock Text="{Binding Platform}" FontSize="9.5" Foreground="{Binding BrandBrush}" Opacity="0.88" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <StackPanel Margin="56,36" Spacing="20" MaxWidth="860" HorizontalAlignment="Center">
      <!-- 1. Project & Version Banner -->
      <Border Classes="glass-card" Padding="20">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18" VerticalAlignment="Center">
          <Image Source="/Assets/uptime.png" Width="56" Height="56" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="Uptime" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
              <Border CornerRadius="999" Padding="10,2" Background="#247BC4A8" BorderBrush="#667BC4A8" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="VersionBadgeText" Text="{Binding AboutVersionBadge}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>
            </StackPanel>
            <TextBlock Classes="hint" i18n:Localize.TextKey="AboutProjectTagline" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 2. Complete Categorized Changelog (High-Readability Container) -->
      <Border Padding="22" CornerRadius="12" Background="#DE0B0F15" BorderBrush="#40FFFFFF" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Classes="lbl" i18n:Localize.TextKey="LblChangelog" Foreground="{DynamicResource AccentBrush}" />

          <StackPanel Spacing="4">
            <TextBlock i18n:Localize.TextKey="LblChangelogMonitor" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock i18n:Localize.TextKey="ChangelogMonitorBody" Foreground="#F3F4F6" FontSize="13.5" TextWrapping="Wrap" LineHeight="24" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock i18n:Localize.TextKey="LblChangelogStability" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock i18n:Localize.TextKey="ChangelogStabilityBody" Foreground="#F3F4F6" FontSize="13.5" TextWrapping="Wrap" LineHeight="24" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock i18n:Localize.TextKey="LblChangelogPower" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock i18n:Localize.TextKey="ChangelogPowerBody" Foreground="#F3F4F6" FontSize="13.5" TextWrapping="Wrap" LineHeight="24" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock i18n:Localize.TextKey="LblChangelogExperience" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock i18n:Localize.TextKey="ChangelogExperienceBody" Foreground="#F3F4F6" FontSize="13.5" TextWrapping="Wrap" LineHeight="24" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding LiveChangelogAdded}" IsVisible="{Binding HasLiveChangelogAdded}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LiveChangelogEntry">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                  <Border CornerRadius="999" Padding="8,1" Background="#247BC4A8" BorderBrush="#667BC4A8" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                  </Border>
                  <TextBlock Text="{Binding Text}" Foreground="#F3F4F6" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="#24FFFFFF" Margin="0,4" />
          <TextBlock Classes="lbl" i18n:Localize.TextKey="LblRemoved" Foreground="#F87171" />
          <TextBlock i18n:Localize.TextKey="AboutRemovedFull"
                     Foreground="#E5E7EB"
                     FontSize="13.5"
                     TextWrapping="Wrap"
                     LineHeight="24" />
          <ItemsControl ItemsSource="{Binding LiveChangelogRemoved}" IsVisible="{Binding HasLiveChangelogRemoved}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LiveChangelogEntry">
                <TextBlock Foreground="#FCA5A5" FontSize="13.5" TextWrapping="Wrap" LineHeight="24">
                  <Run Text="• " /><Run Text="{Binding Text}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 3. Quick Links & Community -->
      <Border Classes="glass-card" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Classes="lbl" i18n:Localize.TextKey="LblCommunityLinks" />
          <WrapPanel Orientation="Horizontal">
            <Button Classes="ghost" Margin="0,0,10,6" Padding="14,8" Click="OnOpenWebsiteClick"
                    i18n:Localize.ContentKey="AboutBtnWebsite" />
            <Button Classes="ghost" Margin="0,0,10,6" Padding="14,8" Click="OnOpenWallpapersClick"
                    i18n:Localize.ContentKey="AboutBtnWallpapers" />
            <Button Classes="ghost" Margin="0,0,10,6" Padding="14,8" Click="OnOpenGitHubClick"
                    i18n:Localize.ContentKey="AboutBtnGitHub" />
            <Button Margin="0,0,0,6" Padding="14,8" Click="OnOpenDiscordClick"
                    Background="#5865F2" BorderBrush="#7983F5" BorderThickness="1" CornerRadius="8">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="avares://Uptime/Assets/discord-logo.png" Width="16" Height="16"
                       VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
                <TextBlock i18n:Localize.TextKey="AboutBtnDiscord" Foreground="#FFFFFF"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- 4. Privacy & Local-First -->
      <Border Classes="glass-card" Padding="20">
        <StackPanel Spacing="8">
          <TextBlock Classes="lbl" i18n:Localize.TextKey="LblPrivacyLocal" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Classes="hint" i18n:Localize.TextKey="AboutPrivacyLocalBody" FontSize="13" TextWrapping="Wrap" LineHeight="21" />
        </StackPanel>
      </Border>

      <!-- Team & Credits Header -->
      <Border Classes="glass-card" Padding="18,14" Margin="0,6,0,0">
        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" i18n:Localize.TextKey="LblAbout" />
          <TextBlock Classes="hint" i18n:Localize.TextKey="AboutSubtitle" FontSize="13.5" />
        </StackPanel>
      </Border>

      <!-- Moderator 1: ShadowEddyx12 -->
      <Border Classes="glass-card" Padding="18" IsVisible="{Binding IsShadowVisible}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18" VerticalAlignment="Center">
          <Ellipse Width="72" Height="72"
                   Stroke="{DynamicResource OutlineBrush}" StrokeThickness="1.5"
                   RenderOptions.BitmapInterpolationMode="HighQuality">
            <Ellipse.Fill>
              <ImageBrush Source="avares://Uptime/Assets/avatar-shadoweddyx12.webp" Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="ShadowEddyx12" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
              <Image Source="avares://Uptime/Assets/mod-icon.png" Width="15" Height="15" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border CornerRadius="999" Padding="9,2" Background="#1F5865F2" BorderBrush="#665865F2" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock i18n:Localize.TextKey="AboutRoleMod" FontSize="11" FontWeight="SemiBold" Foreground="#A5B4FC" />
              </Border>
            </StackPanel>
            <TextBlock Classes="hint" i18n:Localize.TextKey="AboutModShadowDesc" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding ShadowConnections}" IsVisible="{Binding HasShadowConnections}"
                          ItemTemplate="{StaticResource AboutConnectionChipTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Moderator 2: Luke -->
      <Border Classes="glass-card" Padding="18" IsVisible="{Binding IsLukeVisible}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18" VerticalAlignment="Center">
          <Ellipse Width="72" Height="72"
                   Stroke="{DynamicResource OutlineBrush}" StrokeThickness="1.5"
                   RenderOptions.BitmapInterpolationMode="HighQuality">
            <Ellipse.Fill>
              <ImageBrush Source="avares://Uptime/Assets/avatar-luke.png" Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Luke" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
              <Image Source="avares://Uptime/Assets/mod-icon.png" Width="15" Height="15" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border CornerRadius="999" Padding="9,2" Background="#1F5865F2" BorderBrush="#665865F2" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock i18n:Localize.TextKey="AboutRoleMod" FontSize="11" FontWeight="SemiBold" Foreground="#A5B4FC" />
              </Border>
            </StackPanel>
            <TextBlock Classes="hint" i18n:Localize.TextKey="AboutModLukeDesc" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding LukeConnections}" IsVisible="{Binding HasLukeConnections}"
                          ItemTemplate="{StaticResource AboutConnectionChipTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Dynamic Discord Beta Testers (inserted directly below Luke) -->
      <ItemsControl ItemsSource="{Binding BetaTesters}" IsVisible="{Binding HasBetaTesters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="20" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BetaTesterCard">
            <Border Classes="glass-card" Padding="18">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18" VerticalAlignment="Center">
                <Ellipse Width="72" Height="72"
                         Stroke="#6638BDF8" StrokeThickness="1.5"
                         RenderOptions.BitmapInterpolationMode="HighQuality">
                  <Ellipse.Fill>
                    <ImageBrush Source="{Binding AvatarBitmap}" Stretch="UniformToFill" />
                  </Ellipse.Fill>
                </Ellipse>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    <Image Source="avares://Uptime/Assets/mod-icon.png" Width="15" Height="15" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding IsModerator}" />
                    <Viewbox Width="15" Height="15" VerticalAlignment="Center" IsVisible="{Binding !IsModerator}">
                      <Path Width="24" Height="24" Fill="#38BDF8" Data="M9,2V4H10V8.5L5.2,17.2C4.5,18.4 5.4,20 6.8,20H17.2C18.6,20 19.5,18.4 18.8,17.2L14,8.5V4H15V2H9M12,10.5L15.6,17H8.4L12,10.5Z" />
                    </Viewbox>
                    <Border CornerRadius="999" Padding="9,2" Background="#1F5865F2" BorderBrush="#665865F2" BorderThickness="1" VerticalAlignment="Center" IsVisible="{Binding IsModerator}">
                      <TextBlock i18n:Localize.TextKey="AboutRoleMod" FontSize="11" FontWeight="SemiBold" Foreground="#A5B4FC" />
                    </Border>
                    <Border CornerRadius="999" Padding="9,2" Background="#1F38BDF8" BorderBrush="#6638BDF8" BorderThickness="1" VerticalAlignment="Center" IsVisible="{Binding !IsModerator}">
                      <TextBlock i18n:Localize.TextKey="AboutRoleBetaTester" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                    </Border>
                  </StackPanel>
                  <TextBlock Classes="hint" Text="{Binding Description}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                  <ItemsControl ItemsSource="{Binding Connections}" IsVisible="{Binding HasConnections}"
                                ItemTemplate="{StaticResource AboutConnectionChipTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Developer (Android & iOS): Koi -->
      <Border Classes="glass-card" Padding="18" IsVisible="{Binding IsKoiVisible}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18" VerticalAlignment="Center">
          <Border Width="72" Height="72" CornerRadius="999"
                  Background="#1FA855F7" BorderBrush="#88A855F7" BorderThickness="1.5"
                  ClipToBounds="True">
            <Grid>
              <TextBlock Text="K" FontSize="24" FontWeight="Bold" Foreground="#C084FC"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding MobileDevAvatar, Converter={x:Static ObjectConverters.IsNull}}" />
              <Ellipse Width="72" Height="72"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       IsVisible="{Binding MobileDevAvatar, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Ellipse.Fill>
                  <ImageBrush Source="{Binding MobileDevAvatar}" Stretch="UniformToFill" />
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding MobileDevName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
              <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                <Path Width="24" Height="24" Fill="#C084FC" Data="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm5 16.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2zM7 5v11h10V5H7z" />
              </Viewbox>
              <Border CornerRadius="999" Padding="9,2" Background="#1FA855F7" BorderBrush="#73A855F7" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock i18n:Localize.TextKey="AboutRoleMobileDev" FontSize="11" FontWeight="SemiBold" Foreground="#C084FC" />
              </Border>
            </StackPanel>
            <TextBlock Classes="hint" i18n:Localize.TextKey="AboutMobileDevDesc" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding MobileDevConnections}" IsVisible="{Binding HasMobileDevConnections}"
                          ItemTemplate="{StaticResource AboutConnectionChipTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Owner: IL DENTE PROIBITO -->
      <Border Classes="glass-card" Padding="18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18" VerticalAlignment="Center">
          <Ellipse Width="72" Height="72"
                   Stroke="#88F5C451" StrokeThickness="1.5"
                   RenderOptions.BitmapInterpolationMode="HighQuality">
            <Ellipse.Fill>
              <ImageBrush Source="avares://Uptime/Assets/avatar-owner.jpg" Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="IL DENTE PROIBITO" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
              <Image Source="avares://Uptime/Assets/owner-icon.png" Width="15" Height="15" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border CornerRadius="999" Padding="9,2" Background="#1FF5C451" BorderBrush="#73F5C451" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock i18n:Localize.TextKey="AboutRoleOwner" FontSize="11" FontWeight="SemiBold" Foreground="#F5C451" />
              </Border>
            </StackPanel>
            <TextBlock Classes="hint" i18n:Localize.TextKey="AboutOwnerDesc" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding OwnerConnections}" IsVisible="{Binding HasOwnerConnections}"
                          ItemTemplate="{StaticResource AboutConnectionChipTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
