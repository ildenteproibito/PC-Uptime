<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="using:Uptime.Presentation.Localization"
             xmlns:c="using:Uptime.Presentation.Controls"
             x:Class="Uptime.Presentation.Views.MonitorView">
  <Grid RowDefinitions="*,76">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
      <StackPanel Margin="56,40,56,24" Spacing="36">

        <StackPanel>
          <TextBlock Classes="lbl" i18n:Localize.TextKey="LblSince" />
          <StackPanel Orientation="Horizontal" Spacing="28">
            <TextBlock Text="{Binding PrimaryText}" FontSize="88" FontWeight="Light"
                       LetterSpacing="-2" VerticalAlignment="Bottom" />
            <TextBlock Text="{Binding SecondaryText}" FontSize="26" FontWeight="Light"
                       Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,14" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
            <TextBlock Text="{Binding BootText}" Classes="muted" FontSize="14" />
            <TextBlock Text="·" Classes="muted" FontSize="14" />
            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="14" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="13" Margin="0,5,0,0" Text="{Binding PersonalRecordText}" />
        </StackPanel>

        <StackPanel Spacing="14">
          <TextBlock i18n:Localize.TextKey="RulerCaption" Classes="muted" FontSize="13" />
          <c:TimeRuler Height="64" FilledTicks="{Binding FilledTicks}" Labels="{Binding RulerLabels}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="56">
          <StackPanel Grid.Column="0" IsVisible="{Binding ShowSession}">
            <TextBlock Classes="lbl" i18n:Localize.TextKey="LblSession" />
            <Border Classes="row"><Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="muted" FontSize="14" i18n:Localize.TextKey="RowStarted" />
              <TextBlock Grid.Column="1" FontSize="14" Text="{Binding StartedText}" />
            </Grid></Border>
            <Border Classes="row"><Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="muted" FontSize="14" i18n:Localize.TextKey="RowIdle" />
              <TextBlock Grid.Column="1" FontSize="14" Text="{Binding IdleText}" />
            </Grid></Border>
          </StackPanel>

          <StackPanel Grid.Column="1" IsVisible="{Binding ShowAdvice}">
            <TextBlock Classes="lbl" i18n:Localize.TextKey="LblAdvice" />
            <TextBlock FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="#C4C8CF"
                       Text="{Binding AdviceText}" />
          </StackPanel>

          <StackPanel Grid.Column="2" IsVisible="{Binding ShowSystem}">
            <TextBlock Classes="lbl" i18n:Localize.TextKey="LblSystem" />
            <Border Classes="row"><Grid ColumnDefinitions="Auto,*">
              <TextBlock Classes="muted" FontSize="14" i18n:Localize.TextKey="RowOs" />
              <TextBlock Grid.Column="1" FontSize="14" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                         Margin="16,0,0,0" Text="{Binding OsText}" />
            </Grid></Border>
            <Border Classes="row"><Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="muted" FontSize="14" i18n:Localize.TextKey="RowThreads" />
              <TextBlock Grid.Column="1" FontSize="14" Text="{Binding ThreadsText}" />
            </Grid></Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}" Padding="28,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Button Classes="ghost" i18n:Localize.ContentKey="ActionCopy" Click="OnCopyClick" />
        <Button Classes="ghost" i18n:Localize.ContentKey="ActionBadge" Click="OnBadgeClick" />
        <Button Classes="ghost" i18n:Localize.ContentKey="ActionHud" Click="OnHudClick" />
        <Button Classes="ghost" i18n:Localize.ContentKey="NavSettings" Click="OnSettingsClick" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
