<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="using:Uptime.Presentation.Localization"
             xmlns:v="using:Uptime.Presentation.Views"
             xmlns:vm="using:Uptime.Presentation.ViewModels"
             x:Class="Uptime.Presentation.Views.WallpapersView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer x:Name="GalleryScrollViewer" VerticalScrollBarVisibility="Hidden">
    <StackPanel Margin="56,40" Spacing="24" HorizontalAlignment="Stretch">
      <Border Classes="glass-card" MaxWidth="850" HorizontalAlignment="Left">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="lbl" i18n:Localize.TextKey="LblCommunityWallpapers" />
            <TextBlock Classes="hint" i18n:Localize.TextKey="CommunityDesc" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="ghost" Padding="14,8" Command="{Binding OpenCurrentWallpaperStudioCommand}"
                    IsVisible="{Binding HasCustomBackgroundImage}" i18n:Localize.ContentKey="WallpaperOpenStudio" />
            <Button Classes="ghost" Padding="14,8" Command="{Binding RefreshCommunityWallpapersCommand}"
                    IsEnabled="{Binding !IsCommunityBusy}" i18n:Localize.ContentKey="CommunityRefresh" />
            <Button Classes="ghost" Padding="14,8" Command="{Binding OpenCommunityWebsiteCommand}"
                    i18n:Localize.ContentKey="CommunityOpenSite" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Upload & share wallpaper with preview -->
      <Border Classes="glass-card" Padding="14" MaxWidth="850" HorizontalAlignment="Left">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
          <Border Width="208" Height="117" CornerRadius="10" ClipToBounds="True"
                  Background="#0D1014" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                  IsVisible="{Binding HasPublishPreview}">
            <Grid>
              <Image Source="{Binding PublishPreviewImage}" Stretch="UniformToFill" />
              <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="6,2"
                      CornerRadius="6" Background="#B00D1014">
                <TextBlock Text="{Binding PublishPreviewResolution}" FontSize="10.5" Foreground="{DynamicResource TextBrush}" />
              </Border>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <TextBox Text="{Binding CommunityTitle}" i18n:Localize.WatermarkKey="CommunityTitleHint" MaxLength="80" />
              <TextBox Grid.Column="1" Text="{Binding CommunityAuthor}" i18n:Localize.WatermarkKey="CommunityAuthorHint" MaxLength="40" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost" Padding="14,8" Click="OnPickCommunityImageClick"
                      IsEnabled="{Binding !IsCommunityBusy}" i18n:Localize.ContentKey="CommunityChooseImage" />
              <Button Classes="accent" Padding="16,8" Command="{Binding PublishCurrentWallpaperCommand}"
                      IsEnabled="{Binding !IsCommunityBusy}" i18n:Localize.ContentKey="CommunityShare" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="glass-card" Padding="14,10" HorizontalAlignment="Left"
              IsVisible="{Binding CommunityStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding CommunityStatus}" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                   TextWrapping="Wrap" />
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost" Padding="12,6"
                Command="{Binding SetCommunityFilterAllCommand}"
                Classes.accent="{Binding IsFilterAll}"
                i18n:Localize.ContentKey="WallpaperFilterAll" />
        <Button Classes="ghost" Padding="12,6"
                Command="{Binding SetCommunityFilterUltrawideCommand}"
                Classes.accent="{Binding IsFilterUltrawide}"
                i18n:Localize.ContentKey="WallpaperFilterUltrawide" />
        <Button Classes="ghost" Padding="12,6"
                Command="{Binding SetCommunityFilterFavoritesCommand}"
                Classes.accent="{Binding IsFilterFavorites}"
                Content="Favorites" />
      </StackPanel>

      <!-- Community gallery list with 16:9 image previews -->
      <ItemsControl ItemsSource="{Binding CommunityWallpapers}" HorizontalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CommunityWallpaperCard">
            <Border Width="244" Margin="0,0,14,14" CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
              <StackPanel>
                <Border Height="137" CornerRadius="11,11,0,0" Background="#0D1014" ClipToBounds="True">
                  <Grid>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                           RenderOptions.BitmapInterpolationMode="MediumQuality" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                            Padding="7,2" CornerRadius="999"
                            Background="#CC0B0F15" BorderBrush="#667BC4A8" BorderThickness="1"
                            IsVisible="{Binding IsUltrawide}">
                      <TextBlock Text="{Binding AspectBadge}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            Width="28" Height="28" Padding="0" CornerRadius="999"
                            Background="#B80B0F15" BorderBrush="#44FFFFFF" BorderThickness="1"
                            ToolTip.Tip="Favorite"
                            Command="{Binding $parent[v:WallpapersView].((vm:SettingsViewModel)DataContext).ToggleFavoriteWallpaperCommand}"
                            CommandParameter="{Binding}">
                      <Viewbox Width="14" Height="14">
                        <Path Width="24" Height="24" Fill="{Binding FavoriteColor}"
                              Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z" />
                      </Viewbox>
                    </Button>
                  </Grid>
                </Border>
                <StackPanel Margin="12" Spacing="8">
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            ToolTip.Tip="View author profile"
                            Command="{Binding $parent[v:WallpapersView].((vm:SettingsViewModel)DataContext).OpenAuthorProfileCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Author}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                 TextDecorations="Underline"
                                 TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="128" VerticalAlignment="Center" />
                    </Button>
                    <Image Source="{Binding RoleIcon}" IsVisible="{Binding HasRoleIcon}"
                           Width="13" Height="13" VerticalAlignment="Center"
                           ToolTip.Tip="{Binding RoleTooltip}"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center">
                      <Run Text="· " /><Run Text="{Binding Resolution}" />
                    </TextBlock>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Classes="ghost" Padding="8,6" HorizontalAlignment="Stretch"
                            Command="{Binding $parent[v:WallpapersView].((vm:SettingsViewModel)DataContext).PreviewCommunityWallpaperCommand}"
                            CommandParameter="{Binding}"
                            i18n:Localize.ContentKey="WallpaperPreviewBtn" />
                    <Button Grid.Column="1" Classes="ghost" Padding="8,6" HorizontalAlignment="Stretch"
                            Command="{Binding $parent[v:WallpapersView].((vm:SettingsViewModel)DataContext).ApplyCommunityWallpaperCommand}"
                            CommandParameter="{Binding}"
                            i18n:Localize.ContentKey="CommunityApply" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
