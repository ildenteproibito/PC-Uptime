<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#0F1114" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1E24" />
    <SolidColorBrush x:Key="LineBrush" Color="#1D2026" />
    <SolidColorBrush x:Key="RowLineBrush" Color="#1A1D22" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#2A2E36" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8EAED" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A9" />
    <SolidColorBrush x:Key="DimBrush" Color="#8D939C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7BC4A8" />
    <SolidColorBrush x:Key="AmberBrush" Color="#E0A458" />
    <SolidColorBrush x:Key="OrangeBrush" Color="#E8845A" />
    <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI, Inter, sans-serif</FontFamily>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.lbl">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource RowLineBrush}" />
    <Setter Property="Padding" Value="0,11" />
  </Style>

  <!-- Tab di navigazione -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.nav.on">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.nav.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
  </Style>

  <!-- Pulsante con contorno -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.window-control">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.window-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
  </Style>
  <Style Selector="Button.window-control.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
  </Style>
  <Style Selector="Border.language-switch">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Button.language-option">
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.language-option-full">
    <Setter Property="MinWidth" Value="82" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="Button.language-option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource OutlineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.language-option.on">
    <Setter Property="Foreground" Value="#111418" />
  </Style>
  <Style Selector="Button.language-option.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="#20242A" />
    <Setter Property="BorderBrush" Value="#3A4149" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Foreground" Value="#E8EAED" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>
</Styles>
