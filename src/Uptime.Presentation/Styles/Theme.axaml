<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#0F1114" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1E24" />
    <SolidColorBrush x:Key="GlassCardBgBrush" Color="#BA0B0F15" />
    <SolidColorBrush x:Key="GlassCardBorderBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="GhostButtonBgBrush" Color="#A60B0F15" />
    <SolidColorBrush x:Key="LineBrush" Color="#1D2026" />
    <SolidColorBrush x:Key="RowLineBrush" Color="#1A1D22" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#2A2E36" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8EAED" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A9" />
    <SolidColorBrush x:Key="DimBrush" Color="#8D939C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7BC4A8" />
    <SolidColorBrush x:Key="AmberBrush" Color="#E0A458" />
    <SolidColorBrush x:Key="OrangeBrush" Color="#E8845A" />
    <Color x:Key="SystemAccentColor">#7BC4A8</Color>
    <Color x:Key="SystemAccentColorDark1">#6CB599</Color>
    <Color x:Key="SystemAccentColorDark2">#5DA68A</Color>
    <Color x:Key="SystemAccentColorDark3">#4E977B</Color>
    <Color x:Key="SystemAccentColorLight1">#8CD0B7</Color>
    <Color x:Key="SystemAccentColorLight2">#9DDCB6</Color>
    <Color x:Key="SystemAccentColorLight3">#AEE8D5</Color>
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#7BC4A8" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#8CD0B7" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#6CB599" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#7BC4A8" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#8CD0B7" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#6CB599" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0F1114" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0F1114" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0F1114" />
    <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI, Inter, sans-serif</FontFamily>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.lbl">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,11" />
  </Style>

  <Style Selector="Border.glass-card">
    <Setter Property="Background" Value="{DynamicResource GlassCardBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,16" />
  </Style>

  <!-- Navigation tabs -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.nav:pointerover">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2E7BC4A8" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.nav.on">
    <Setter Property="Foreground" Value="#111418" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#7BC4A8" />
    <Setter Property="Foreground" Value="#111418" />
  </Style>
  <Style Selector="Button.nav.on:pointerover">
    <Setter Property="Foreground" Value="#111418" />
  </Style>
  <Style Selector="Button.nav.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#8CD0B7" />
    <Setter Property="Foreground" Value="#111418" />
  </Style>
  <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#6CB599" />
    <Setter Property="Foreground" Value="#111418" />
  </Style>
  <Style Selector="Button.nav.top-tab">
    <Setter Property="CornerRadius" Value="0,0,14,14" />
    <Setter Property="Padding" Value="18,8,18,10" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- Outline ghost button -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{DynamicResource GhostButtonBgBrush}" />
    <Setter Property="BorderBrush" Value="#667BC4A8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.window-control">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.window-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2E7BC4A8" />
  </Style>
  <Style Selector="Button.window-control.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
  </Style>
  <Style Selector="Border.language-switch">
    <Setter Property="Background" Value="#38000000" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Button.language-option">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.language-option-full">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.language-option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2E7BC4A8" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.language-option.on">
    <Setter Property="Foreground" Value="#111418" />
  </Style>
  <Style Selector="Button.language-option.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.language-option.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#111418" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="#20242A" />
    <Setter Property="BorderBrush" Value="#3A4149" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Foreground" Value="#E8EAED" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Foreground" Value="#111418" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#7BC4A8" />
    <Setter Property="BorderBrush" Value="#7BC4A8" />
    <Setter Property="Foreground" Value="#111418" />
  </Style>
  <Style Selector="Button.ghost:pressed">
    <Setter Property="Foreground" Value="#111418" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#6CB599" />
    <Setter Property="BorderBrush" Value="#6CB599" />
    <Setter Property="Foreground" Value="#111418" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- ToggleSwitch: Uptime brand green accent (#7BC4A8) -->
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="#8CD0B7" />
    <Setter Property="BorderBrush" Value="#8CD0B7" />
  </Style>
  <Style Selector="ToggleSwitch:checked:pressed /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="#6CB599" />
    <Setter Property="BorderBrush" Value="#6CB599" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
    <Setter Property="Fill" Value="{DynamicResource BgBrush}" />
  </Style>

  <!-- Theme carousel tile styles -->
  <Style Selector="Button.theme-tile">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.theme-tile /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.theme-tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Carousel arrow navigation buttons -->
  <Style Selector="Button.carousel-nav">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="52" />
    <Setter Property="Background" Value="#147BC4A8" />
    <Setter Property="BorderBrush" Value="#597BC4A8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#7BC4A8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0,0,0,2" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.carousel-nav:pointerover">
    <Setter Property="Foreground" Value="#111418" />
  </Style>
  <Style Selector="Button.carousel-nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#7BC4A8" />
    <Setter Property="BorderBrush" Value="#7BC4A8" />
    <Setter Property="Foreground" Value="#111418" />
  </Style>

  <!-- Custom wallpaper '+' tile -->
  <Style Selector="Button.theme-tile-custom">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.theme-tile-custom /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.theme-tile-custom:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.theme-tile-custom:pointerover Border.tile-border">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.theme-tile-custom:pointerover TextBlock.plus-icon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Clear custom wallpaper button -->
  <Style Selector="Button.custom-clear">
    <Setter Property="Background" Value="#CC1B1E24" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.custom-clear:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E52B50" />
  </Style>
</Styles>
