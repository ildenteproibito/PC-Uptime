{
  "name": "uptime-trailer",
  "version": "1.0.0",
  "description": "Official Cinematic Launch Film for Uptime",
  "private": true,
  "scripts": {
    "start": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts Trailer out/uptime-trailer.mp4 --gl=angle",
    "still": "remotion still src/index.ts Poster out/poster.png --gl=angle"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.260",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.260"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
