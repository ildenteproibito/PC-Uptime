<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AwayUptime.NightPromptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Uptime" Width="380" Height="175" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" FontFamily="Segoe UI Variable Display, Segoe UI, Noto Sans KR, Malgun Gothic, Microsoft YaHei, Meiryo, sans-serif" xmlns:awayuptime="clr-namespace:AwayUptime;assembly=Uptime">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ModernButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#2D2D33" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#40404C" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="border" Property="Border.Background" Value="#383842" />
                  <Setter TargetName="border" Property="Border.BorderBrush" Value="#4CC2FF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DangerButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#5C1D24" />
        <Setter Property="Foreground" Value="#FFA4A4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#8A2E38" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="border" Property="Border.Background" Value="#75252E" />
                  <Setter TargetName="border" Property="Border.BorderBrush" Value="#FF6B6B" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Margin="8" Background="#1C1C1E" BorderBrush="#40404C" BorderThickness="1" CornerRadius="12">
    <UIElement.Effect>
      <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.65" Color="#000000" />
    </UIElement.Effect>
    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="🌙 " FontSize="14" VerticalAlignment="Center" />
          <TextBlock Name="TxtTitle" Text="Buonanotte da Uptime" FontSize="13" FontWeight="Bold" Foreground="#EDEDED" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
      <TextBlock Name="TxtMessage" Grid.Row="1" Text="Il computer è inattivo da oltre 30 minuti. Vuoi spegnerlo per risparmiare energia?" FontSize="11" Foreground="#B4B4C0" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10" />
      <Grid Row="2">
        <Button Name="BtnStayOn" Style="{StaticResource ModernButton}" Content="Lascialo Acceso" HorizontalAlignment="Left" MinWidth="120" Click="BtnStayOn_Click" />
        <Button Name="BtnShutdown" Style="{StaticResource DangerButton}" Content="Spegni PC" HorizontalAlignment="Right" MinWidth="110" Click="BtnShutdown_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>