<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AwayUptime.MiniHudWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Uptime HUD" Width="275" Height="76" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" FontFamily="Segoe UI Variable Display, Segoe UI, Noto Sans KR, Malgun Gothic, Microsoft YaHei, Meiryo, sans-serif" xmlns:awayuptime="clr-namespace:AwayUptime;assembly=Uptime" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="HudActionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="BrdBtn" Background="{TemplateBinding Control.Background}" CornerRadius="11">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="BrdBtn" Property="Border.Background" Value="#25FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="BrdBtn" Property="Border.Background" Value="#15FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="HudCloseButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="BrdClose" Background="{TemplateBinding Control.Background}" CornerRadius="11">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="BrdClose" Property="Border.Background" Value="#45E53935" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="BrdClose" Property="Border.Background" Value="#30E53935" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="BrdHudMain" Margin="14" Height="48" Background="#E6161820" BorderThickness="1" CornerRadius="16" Cursor="SizeAll" ToolTip="Doppio clic per aprire Uptime • Trascina per riposizionare">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#45FFFFFF" Offset="0.0" />
        <GradientStop Color="#12FFFFFF" Offset="1.0" />
      </LinearGradientBrush>
    </Border.BorderBrush>
    <UIElement.Effect>
      <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="3" Opacity="0.65" Color="#000000" />
    </UIElement.Effect>
    <Grid Margin="10,0" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#182E44" BorderBrush="#2C5278" BorderThickness="1" Margin="0,0,8,0">
        <Grid>
          <ui:SymbolIcon Symbol="Timer20" Foreground="#4CC2FF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Width="7" Height="7" CornerRadius="3.5" Background="#00E676" BorderBrush="#161820" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
        </Grid>
      </Border>
      <TextBlock Name="TxtHudCounter" Grid.Column="1" Text="0g 00h 00m 00s" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
        <Button Name="BtnHudOpen" Style="{StaticResource HudActionButtonStyle}" ToolTip="Apri Uptime" Margin="0,0,3,0" Click="OpenApp_Click">
          <ui:SymbolIcon Symbol="Open16" Foreground="#88A0B8" FontSize="11" />
        </Button>
        <Button Name="BtnHudClose" Style="{StaticResource HudCloseButtonStyle}" ToolTip="Chiudi Mini-HUD" Click="CloseHud_Click">
          <ui:SymbolIcon Symbol="Dismiss16" Foreground="#88A0B8" FontSize="11" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>